{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Toyless",
            "type": "shell",
            "command": "ninja -C build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean & Reconfigure",
            "type": "shell",
            "command": "rm -rf build && cmake -B build -G Ninja",
            "problemMatcher": []
        }
    ]
}